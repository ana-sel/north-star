{
  "name": "compass-app",
  "version": "1.0.0",
  "description": "Compass - A private personal navigation app (sleep tracking, energy, mood, planning)",
  "main": "index.ts",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "expo run:android",
    "build:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "ios": "expo run:ios",
    "test:content": "jest --runInBand"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "expo": "^58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-sqlite": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "~30.5.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
